#!/usr/bin/env bash
# Поддельный ps для provision_cli (ставится в PATH только в отдельных случаях): FAKE_PS=empty — успех без вывода,
# иначе — код 1. Лежит рядом с остальными подделками, а не в /tmp: tmpfs контейнера может быть noexec, и отказ
# «ps не выполнился» получился бы случайным.
[ "${FAKE_PS:-fail}" = empty ] && exit 0
exit 1
