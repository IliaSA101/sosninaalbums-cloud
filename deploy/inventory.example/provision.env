# Пример ~/inventory/provision.env (SA_INVENTORY: приватный inventory в доме учётной записи раскатки, свой git;
# правится только на её консоли, изменения из других мест просматриваются как код).
# Только KEY=VALUE, без кавычек и без исполнения кода: provision.sh читает перечисленные ключи.
# Значения здесь выдуманные.

# Единственный источник домена: PTR адреса, albums_domain для Caddy и public_base сервиса (001-22: домен
# менять нельзя, не сломав выданные ссылки).
SA_DOMAIN=albums.example.org

# В 0.1 — только способ bootstrap и провайдер clo; другое — код 2 «не реализовано».
SA_START=bootstrap
SA_PROVIDER=clo

# Администратор сервера (ключи и пароль — в ansible/group_vars/all), пользователь забора копий.
SA_ADMIN_USER=admin-example
SA_BACKUP_USER=sa-backup

# Первый вход до bootstrap: root или пользователь образа провайдера (тогда укажите и SA_IMAGE_USER — его
# блокируют и удаляют). Что отдаёт образ — проверяется на пробной аренде.
SA_BOOTSTRAP_USER=root
SA_IMAGE_USER=
