---
# Пример ~/inventory/ansible/hosts.yml. Файл пишет provision.sh apply по `tofu output` (после обрыва apply — provision.sh hosts) —
# вручную не нужен; адрес из документации (192.0.2.0/24): настоящий provision.sh такой адрес отвергает (служебный диапазон).
all:
  hosts:
    server:
      ansible_host: 192.0.2.10
