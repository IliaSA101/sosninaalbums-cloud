# Константы проверки выпущенного образа (спека 004, design §8): читает ops/image.sh как данные (KEY=VALUE, без
# исполнения кода). Источник правды — этот файл в просмотренном клоне: ни окружение, ни флаг их не переопределяют
# (тесты подставляют другой файл в копию дерева). Правка любой строки меняет личность подписанта — это решение
# владельца, а не рядовая правка.

# Репозиторий, его числовой id (переименование ловит id), рабочий процесс подписи и издатель сертификата. Значение
# рабочего процесса — путь БЕЗ экранирования: gh (проверено на 2.103.3) экранирует его сам, и с «\.» проверка
# отказывает; регулярным выражением значение не является.
IC_REPO=IliaSA101/sosninaalbums-cloud
IC_REPO_ID=1440574753
IC_SIGNER_WORKFLOW=IliaSA101/sosninaalbums-cloud/.github/workflows/release.yml
IC_ISSUER=https://token.actions.githubusercontent.com

# Что обязан сказать сертификат Fulcio (не предикат): событие, раннер и видимость репозитория в момент подписи;
# метка выпуска — префикс ссылки плюс версия vX.Y.Z; субъект утверждения — ровно образ.
IC_TRIGGER=push
IC_RUNNER=github-hosted
IC_VISIBILITY=public
IC_REF_PREFIX=refs/tags/
IC_SUBJECT=ghcr.io/iliasa101/albums-svc

# Улики во входящих: ровно два имени (расширение .jsonl нужно gh: разбор bundle выбирается по нему) и предел размера.
IC_EV_MANIFEST=release.manifest.json
IC_EV_BUNDLE=release.attestation.jsonl
IC_EV_MAX=1048576

# Откуда берётся gh (архив выпуска) и версия не ниже: в 2.67.0 закрыта CVE-2025-25204; 2.103.3 проверена прототипом.
IC_GH_REPO=cli/cli
IC_GH_MIN=2.103.3
