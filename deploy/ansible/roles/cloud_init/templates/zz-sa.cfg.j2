# Управляется Ansible (роль cloud_init, design 002 §10): правки руками будут перезаписаны.
# Имя zz-: cloud-init читает cloud.cfg.d по алфавиту, поздний файл перекрывает ранний, а список заменяется
# целиком. При смене метаданных cloud-init заново выполняет модули пользователей, паролей и ключей, то есть
# даёт провайдеру вторую дорогу к входу мимо агента. Списки ниже — итоговые списки образа без этих модулей;
# сеть не затронута.
{% for stage in cloud_init_stages %}
{{ stage }}:
{% for item in cloud_init_kept[stage] %}
  - {{ item | to_json }}
{% endfor %}
{% endfor %}
