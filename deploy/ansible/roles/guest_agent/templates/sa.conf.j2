# Управляется Ansible (роль guest_agent, design 002 §10): правки руками будут перезаписаны.
# Пустой ExecStart= сбрасывает исходную команду юнита. Дальше — тот же бинарник со своим файлом настроек:
# белый список лежит в нём, а не в аргументах, и чужие настройки (QGA_CONF, /etc/qemu/qemu-ga.conf) не
# подмешиваются: -c указывает единственный файл.
[Service]
ExecStart=
ExecStart=-{{ guest_agent_binary }} -c {{ guest_agent_conf }}
